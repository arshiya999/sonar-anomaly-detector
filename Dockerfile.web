FROM node:20-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ENV ML_API_URL=http://ml:8765
ENV OPS_API_URL=http://api:8766
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

EXPOSE 47281
CMD ["sh", "-c", "npx next start --hostname 0.0.0.0 --port ${PORT:-47281}"]
